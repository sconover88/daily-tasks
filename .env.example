# Copy this file to .env.local and fill in the two Supabase values.
# See SUPABASE_SETUP.md for exactly where to find them.

# Supabase > Project Settings > Data API (or "API") > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys > Secret key (starts with sb_secret_)
# or the legacy "service_role" key. Keep this private. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=paste-your-secret-key-here

# When "today" rolls over. Mountain time with daylight saving: America/Denver
# Arizona (Mountain Standard Time all year): America/Phoenix
APP_TIME_ZONE=America/Denver
